{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"useSemanticElements": "off",
				"useKeyWithClickEvents": "off",
				"noNoninteractiveTabindex": "off"
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noUnusedLabels": "error",
				"noUnusedFunctionParameters": "error"
			},
			"style": {
				"useConst": "error",
				"useBlockStatements": "error"
			},
			"suspicious": {
				"noConsole": "warn",
				"noDebugger": "error",
				"noVar": "error",
				"noWith": "error"
			},
			"complexity": {
				"noUselessFragments": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"semicolons": "always",
			"quoteStyle": "single",
			"trailingCommas": "es5"
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"files": {
		"includes": [
			"**",
			"!**/coverage/**",
			"!**/dist/**",
			"!**/node_modules/**",
			"!**/src/api/**",
			"!**/src/js/**",
			"!**/src/css/**",
			"!**/src/assets/**",
			"!**/src/sw.js",
			"!**/src/env.js"
		]
	}
}
