{
  "name": "baredo-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "approve-builds": "pnpm approve-builds"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "ky": "^2.2.0",
    "preact": "^11.2.0",
    "preact-iso": "^2.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
