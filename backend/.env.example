# Flask Configuration
FLASK_ENV=development
PORT=8000

SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Database (docker compose usa estas variables; en local sin compose se usa sqlite por defecto)
POSTGRES_USER=baredo
POSTGRES_PASSWORD=your-db-password-change-in-production
POSTGRES_DB=baredo

# CORS (csv). Default: localhost dev. En produccion setear el dominio del frontend.
CORS_ORIGINS=http://localhost:3000

# Request limits / rate limiting
# MAX_CONTENT_LENGTH=1048576
