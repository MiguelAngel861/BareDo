# Copia este archivo a .env en la raiz: cp .env.example .env
# Docker Compose lee este archivo; .env esta ignorado por git. No subas tus secretos.

# Flask / API
FLASK_ENV=production
SECRET_KEY=REPLACE_ME_secret_key
JWT_SECRET_KEY=REPLACE_ME_jwt_secret_key
# Con el proxy /api de nginx no hace falta el hostname publico.
# Anadelo solo si expones el API en otro dominio, separado por comas.
CORS_ORIGINS=http://localhost:3000

# Postgres externo: Compose no levanta ningun contenedor de base de datos.
# Acepta postgres://... o postgresql://...; el backend lo normaliza a psycopg3.
# Si Postgres corre en el host, usa host.docker.internal: Compose lo mapea al
# host con extra_hosts. "localhost" dentro del contenedor es el contenedor mismo.
DATABASE_URL=postgresql+psycopg://REPLACE_ME_user:REPLACE_ME_password@REPLACE_ME_host:5432/REPLACE_ME_db
