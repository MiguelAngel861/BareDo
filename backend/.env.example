# Flask Configuration
FLASK_ENV=development
PORT=5000

SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Database local (opcional): sin DATABASE_URL el backend usa sqlite.
# Para Postgres externo, define DATABASE_URL en la raiz .env (usa docker compose).
POSTGRES_USER=baredo
POSTGRES_PASSWORD=your-db-password-change-in-production
POSTGRES_DB=baredo

# CORS (csv). Default: localhost dev. En produccion setear el dominio del frontend.
CORS_ORIGINS=http://localhost:3000

# Request limits / rate limiting
# MAX_CONTENT_LENGTH=1048576
