{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedLabels": "error",
        "noUnusedFunctionParameters": "error"
      },
      "style": {
        "useConst": "error",
        "noVar": "error",
        "useBlockStatements": "error"
      },
      "suspicious": {
        "noConsole": "warn",
        "noDebugger": "error"
      },
      "complexity": {
        "noUselessFragments": "error",
        "noWith": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "single",
      "trailingCommas": "es5"
    }
  },
  "organizeImports": {
    "enabled": true
  },
  "files": {
    "ignore": [
      "dist/**",
      "node_modules/**",
      "src/api/**",
      "src/js/**",
      "src/css/**",
      "src/assets/**",
      "src/sw.js",
      "src/env.js"
    ]
  }
}
