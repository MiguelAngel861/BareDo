# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///backend/instance/db.sqlite

# PostgreSQL local (docker compose: docker compose up db)
# DATABASE_URL=postgresql://baredo:baredo@localhost:5432/baredo

# PostgreSQL (production, Render):
# DATABASE_URL=postgresql://user:password@host:5432/baredo
# Nota: postgres:// y postgresql:// se normalizan automaticamente a postgresql+psycopg://

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# CORS (csv). Default: localhost dev. En produccion setear el dominio del frontend.
# CORS_ORIGINS=https://baredo-frontend.onrender.com
